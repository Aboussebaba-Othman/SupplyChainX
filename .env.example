# SupplyChainX - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Database Configuration
DB_USERNAME=supplychainx_user
DB_PASSWORD=your_secure_database_password_here

# JWT Configuration (REQUIRED)
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_256_bit_jwt_secret_key_here_minimum_32_characters_required
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Email Configuration (Required if ALERT_EMAIL_ENABLED=true)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# Alert Configuration
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=admin@example.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Server Configuration
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev
