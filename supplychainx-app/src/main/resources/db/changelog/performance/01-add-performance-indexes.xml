<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="add-performance-indexes-supply-orders" author="claude-optimization">
        <validCheckSum>ANY</validCheckSum>
        <comment>Ajout d'index composite pour améliorer les performances des requêtes sur supply_orders</comment>

        <!-- Only create the composite index that doesn't exist elsewhere -->
        <createIndex indexName="idx_supply_orders_status_delivery_date" tableName="supply_orders">
            <column name="status"/>
            <column name="expected_delivery_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="add-performance-indexes-products" author="claude-optimization">
        <validCheckSum>ANY</validCheckSum>
        <comment>Ajout d'index pour améliorer les performances sur products</comment>

        <!-- All indexes already exist in production/01-create-products-table.xml:
             - idx_products_code (line 51)
             - idx_products_category (line 55)
             - idx_products_stock (line 59)
             No new indexes needed for products table -->
    </changeSet>

    <changeSet id="add-performance-indexes-users" author="claude-optimization">
        <validCheckSum>ANY</validCheckSum>
        <comment>Ajout d'index pour authentification rapide</comment>

        <!-- idx_users_username and idx_users_email already exist in security/01-create-users-table.xml -->
        <!-- No new indexes needed for users table -->
    </changeSet>

</databaseChangeLog>
